# Core app settings
SECRET_KEY=replace-me-with-a-long-random-secret
FLASK_APP=wsgi.py
# Optional: point the app at a different dotenv file when not using systemd EnvironmentFile.
# DIKARYA_ENV_FILE=/home/tree/dikarya.environment

# Database and queue
DATABASE_URL=postgresql://user:password@localhost:5432/dikarya
REDIS_URL=redis://localhost:6379/0

# Optional local paths
JOB_DIR=./var/jobs
BLAST_CACHE_DIR=./cache/blast
WORKER_DIR=./var/workers
METRICS_FILE=./var/metrics/system_metrics.jsonl

# External tools
RAXML_BINARY=raxml-ng
IQTREE_BINARY=iqtree2
MRBAYES_BINARY=mb
MAFFT_BINARY=mafft
MUSCLE_BINARY=muscle
CLUSTALO_BINARY=clustalo
TRIMAL_BINARY=trimal
BMGE_BINARY=bmge
FASTTREE_BINARY=/usr/local/bin/FastTree

# NCBI BLAST
BLAST_EMAIL=you@example.com
BLAST_MAX_QUERY_LENGTH=50000
BLAST_POLL_INTERVAL_SECONDS=60

# Defaults for the tree builder
BEGINNER_DEFAULT_ALIGNER=mafft
BEGINNER_DEFAULT_TRIMMING=none
DEFAULT_ML_MODEL=GTR+G
DEFAULT_BOOTSTRAPS=100
DEFAULT_MCMC_GENERATIONS=50000
DEFAULT_MCMC_NRNS=2
DEFAULT_MCMC_CHAINS=4
MAX_CONTENT_LENGTH=16777216

# iNaturalist integration
INAT_CLIENT_ID=
INAT_CLIENT_SECRET=
INAT_CREDENTIALS_FILE=
INAT_TOKEN_FILE=./var/private/inaturalist_token.json
INAT_OAUTH_REDIRECT_URI=
INAT_PUBLIC_BASE_URL=
INAT_OAUTH_ADMIN_EMAILS=

# Admin controls
WHATS_NEW_EDITOR_EMAIL=
TODO_ADMIN_EMAILS=
