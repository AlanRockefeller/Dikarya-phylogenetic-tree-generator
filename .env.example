# Core app settings
SECRET_KEY=replace-me-with-a-long-random-secret
FLASK_APP=wsgi.py
FLASK_ENV=development
# Optional: point the app at a different dotenv file when not using systemd EnvironmentFile.
# DIKARYA_ENV_FILE=/home/tree/dikarya.environment

# Database and queue
DATABASE_URL=postgresql://user:password@localhost:5432/dikarya
REDIS_URL=redis://localhost:6379/0

# Optional local paths
JOB_DIR=./var/jobs
BLAST_CACHE_DIR=./cache/blast
WORKER_DIR=./var/workers
METRICS_FILE=./var/metrics/system_metrics.jsonl
DOSAGE_CSV_DIR=./dosage-calculator
DOSAGE_DB_PATH=./instance/dosage_calculator.sqlite

# RQ worker retention and maintenance
RQ_RESULT_TTL=86400
RQ_MAINTENANCE_INTERVAL=600

# External tools
RAXML_BINARY=raxml-ng
IQTREE_BINARY=iqtree2
MRBAYES_BINARY=mb
MAFFT_BINARY=mafft
MUSCLE_BINARY=muscle
CLUSTALO_BINARY=clustalo
TRIMAL_BINARY=trimal
BMGE_BINARY=bmge
FASTTREE_BINARY=/usr/local/bin/FastTree

# Resource allowances for large analyses. RLIMIT_CPU counts CPU time across
# all threads; the general and RAxML settings are wall-clock hours.
SUBPROCESS_MEMORY_LIMIT_MB=9216
SUBPROCESS_CPU_LIMIT_SECONDS=43200
GENERAL_JOB_TIME_LIMIT_HOURS=8
RAXML_TIME_LIMIT_HOURS=15

# NCBI BLAST
BLAST_EMAIL=you@example.com
BLAST_MAX_QUERY_LENGTH=50000
BLAST_POLL_INTERVAL_SECONDS=60

# MycoMap integration
# Required only for creating or rerunning MycoMap BLAST searches.
MYCOMAP_COM_API_KEY=
MYCOMAP_COM_USER_ID=1
# MYCOMAP_BLAST_RERUN_LIMIT is the legacy fallback for the local limit.
MYCOMAP_BLAST_RERUN_LIMIT=50
MYCOMAP_LOCAL_BLAST_RERUN_LIMIT=50
MYCOMAP_NCBI_BLAST_RERUN_LIMIT=100
# Existing NCBI reruns use a grace period; newly created searches use polling.
MYCOMAP_NCBI_RERUN_WAIT_SECONDS=600
MYCOMAP_NCBI_POLL_INTERVAL_SECONDS=60
MYCOMAP_NCBI_POLL_MAX_ATTEMPTS=120

# Defaults for the tree builder
BEGINNER_DEFAULT_ALIGNER=mafft
BEGINNER_DEFAULT_TRIMMING=none
DEFAULT_ML_MODEL=GTR+G
DEFAULT_BOOTSTRAPS=100
DEFAULT_MCMC_GENERATIONS=50000
DEFAULT_MCMC_NRNS=2
DEFAULT_MCMC_CHAINS=4
MAX_CONTENT_LENGTH=16777216

# iNaturalist integration
INAT_CLIENT_ID=
INAT_CLIENT_SECRET=
INAT_CREDENTIALS_FILE=
INAT_TOKEN_FILE=./var/private/inaturalist_token.json
INAT_OAUTH_REDIRECT_URI=
INAT_PUBLIC_BASE_URL=
INAT_OAUTH_ADMIN_EMAILS=

# Mushroom Observer integration
MUSHROOM_OBSERVER_API_KEY=

# Admin controls
WHATS_NEW_EDITOR_EMAILS=
TODO_ADMIN_EMAILS=
