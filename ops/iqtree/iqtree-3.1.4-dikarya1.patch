From 85048a533460b28c3395a39663cf32da9b105c46 Mon Sep 17 00:00:00 2001
From: Alan Rockefeller <alanrockefeller@gmail.com>
Date: Wed, 7 Oct 2026 20:11:36 +0000
Subject: [PATCH 02/12] UFBoot: print a candidate tree only if some replicate
 takes it

saveCurrentTree() runs for every tree the search scores, including both
alternatives of every NNI evaluated, and printed the tree before looking
at the replicates. With -bnni (print_ufboot_trees = 2) that print sorts
every subtree through a fresh ostringstream and formats every branch
length through iostreams; it was ~27% of an -m MFP -B 1000 -bnni run,
while most candidate trees win no replicate at all.

Run the replicate loop first, marking the samples that take the tree,
then print it once and store it for those samples. The loop only reads
the tree and the same RNG draws happen in the same order, so the stored
strings, counts and log-likelihoods are unchanged.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QBkV69MxCAg5qwKtaWSJ2d
---
 tree/iqtree.cpp | 26 +++++++++++++++++---------
 1 file changed, 17 insertions(+), 9 deletions(-)

diff --git a/tree/iqtree.cpp b/tree/iqtree.cpp
index 93817eeb..b5053580 100644
--- a/tree/iqtree.cpp
+++ b/tree/iqtree.cpp
@@ -3879,15 +3879,11 @@ void IQTree::saveCurrentTree(double cur_logl) {
 //        int ptn;
 //        int updated = 0;
 //        int nsamples = boot_samples.size();
-        ostringstream ostr;
-        string tree_str;
         setRootNode(params->root);
-        if (params->print_ufboot_trees == 2) {
-            printTree(ostr, WT_TAXON_ID + WT_SORT_TAXA + WT_BR_LEN + WT_BR_LEN_SHORT);
-        } else {
-            printTree(ostr, WT_TAXON_ID + WT_SORT_TAXA);
-        }
-        tree_str = ostr.str();
+        // Printing the tree is costly (every subtree is sorted, and with -bnni every branch
+        // length is formatted) and most candidate trees win no replicate, so it is printed
+        // after the loop, only if some replicate took it. The loop does not change the tree.
+        vector<char> took_tree(sample_end - sample_start, 0);
 
     #ifdef _OPENMP
         int rand_seed = random_int(1000);
@@ -3923,13 +3919,25 @@ void IQTree::saveCurrentTree(double cur_logl) {
                 }
                 boot_logl[sample] = max(boot_logl[sample], rell);
                 boot_orig_logl[sample] = cur_logl;
-                boot_trees[sample] = tree_str;
+                took_tree[sample - sample_start] = 1;
             }
         }
     #ifdef _OPENMP
         finish_random(rstream);
         }
     #endif
+        if (find(took_tree.begin(), took_tree.end(), 1) != took_tree.end()) {
+            ostringstream ostr;
+            if (params->print_ufboot_trees == 2) {
+                printTree(ostr, WT_TAXON_ID + WT_SORT_TAXA + WT_BR_LEN + WT_BR_LEN_SHORT);
+            } else {
+                printTree(ostr, WT_TAXON_ID + WT_SORT_TAXA);
+            }
+            string tree_str = ostr.str();
+            for (int sample = sample_start; sample < sample_end; sample++)
+                if (took_tree[sample - sample_start])
+                    boot_trees[sample] = tree_str;
+        }
     }
     if (Params::getInstance().print_tree_lh) {
         out_treelh << cur_logl;
