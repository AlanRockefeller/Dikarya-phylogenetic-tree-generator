From dbb9538c6c00da3f29eac8ea3726c32fcaeccf70 Mon Sep 17 00:00:00 2001
From: Alan Rockefeller <alanrockefeller@gmail.com>
Date: Wed, 7 Oct 2026 21:32:06 +0000
Subject: [PATCH 09/12] Kernels: interleave tip partial likelihoods with vector
 transposes

Where a child is a leaf, the kernels look up the precomputed partial
likelihood of each of the 4 patterns' tip states and interleave them
pattern by pattern into a buffer, which is then read as vectors. The
interleave was one double at a time (clang emits scalar vmovq
load/store pairs), so each 256-bit vector read back had been written by
four separate 8-byte stores, which cannot be forwarded to the load.

Do the interleave in interleaveTipLh(): with 4 patterns per vector and
an AVX target, four vector loads, a 4x4 transpose (unpacklo/hi,
permute2f128) and four vector stores; the old loop otherwise. The same
doubles land at the same places; no arithmetic changes. Used for the
tip-tip and tip-internal partial likelihoods,
computeLikelihoodBufferSIMD and computeLikelihoodBranchSIMD (the rare
multifurcating case is left alone). The helper is file-local because
this header is compiled once per instruction set.

-T 1, 8 real Quick Tree inputs: 19.6 s -> 18.3 s; 2 -m MFP -B 1000
-bnni runs: 47.2 s -> 41.9 s. All outputs identical.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QBkV69MxCAg5qwKtaWSJ2d
---
 tree/phylokernelnew.h | 102 ++++++++++++++++++++++++++++++------------
 1 file changed, 74 insertions(+), 28 deletions(-)

diff --git a/tree/phylokernelnew.h b/tree/phylokernelnew.h
index 2ecf5f10..00adb914 100644
--- a/tree/phylokernelnew.h
+++ b/tree/phylokernelnew.h
@@ -37,6 +37,66 @@
     @param[out] X sum of elements of A
 */
 #ifndef KERNEL_FIX_STATES
+namespace {
+
+/**
+    Interleave the tip partial likelihoods of W patterns, one vector lane each:
+    vec[i*W + x] = tips[x][i] for i < len. Only copies values. The kernels used to do
+    this one double at a time, so every vector they then loaded from vec had been
+    written by W separate stores, which the CPU cannot forward to a vector load.
+    Kept file-local: this header is compiled once per instruction set.
+*/
+template <size_t W>
+struct TipLhInterleave {
+    static inline void run(double *vec, const double *const *tips, size_t len) {
+        for (size_t x = 0; x < W; x++) {
+            double *v = vec + x;
+            const double *t = tips[x];
+            for (size_t i = 0; i < len; i++, v += W)
+                *v = t[i];
+        }
+    }
+};
+
+#if defined(__AVX__) && !defined(__ARM_NEON)
+/** four patterns: a 4x4 transpose per four values */
+template <>
+struct TipLhInterleave<4> {
+    static inline void run(double *vec, const double *const *tips, size_t len) {
+        if (len % 4 != 0) {
+            for (size_t x = 0; x < 4; x++) {
+                double *v = vec + x;
+                const double *t = tips[x];
+                for (size_t i = 0; i < len; i++, v += 4)
+                    *v = t[i];
+            }
+            return;
+        }
+        for (size_t i = 0; i < len; i += 4) {
+            __m256d r0 = _mm256_loadu_pd(tips[0] + i); // a0 a1 a2 a3
+            __m256d r1 = _mm256_loadu_pd(tips[1] + i); // b0 b1 b2 b3
+            __m256d r2 = _mm256_loadu_pd(tips[2] + i); // c0 c1 c2 c3
+            __m256d r3 = _mm256_loadu_pd(tips[3] + i); // d0 d1 d2 d3
+            __m256d u0 = _mm256_unpacklo_pd(r0, r1);   // a0 b0 a2 b2
+            __m256d u1 = _mm256_unpackhi_pd(r0, r1);   // a1 b1 a3 b3
+            __m256d u2 = _mm256_unpacklo_pd(r2, r3);   // c0 d0 c2 d2
+            __m256d u3 = _mm256_unpackhi_pd(r2, r3);   // c1 d1 c3 d3
+            _mm256_storeu_pd(vec + 4*i,      _mm256_permute2f128_pd(u0, u2, 0x20)); // a0 b0 c0 d0
+            _mm256_storeu_pd(vec + 4*i + 4,  _mm256_permute2f128_pd(u1, u3, 0x20)); // a1 b1 c1 d1
