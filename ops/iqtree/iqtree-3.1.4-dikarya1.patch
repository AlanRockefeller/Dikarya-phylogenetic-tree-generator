From 4560fbda838d9e514b9aba3ee28a2c82a03d6f2d Mon Sep 17 00:00:00 2001
From: Alan Rockefeller <alanrockefeller@gmail.com>
Date: Wed, 7 Oct 2026 20:35:00 +0000
Subject: [PATCH 04/12] UFBoot: refresh the checkpoint only when it is about to
 be dumped

refineBootTrees() called saveCheckpoint() after every one of the 1000
refined trees, and doTreeSearch() after every iteration. With UFBoot
that serializes all boot_trees, their log-likelihoods (via iostream
double formatting) and the split graphs, so the cost grows with
replicates x trees; it was ~10% of an -m MFP -B 1000 -bnni run and most
of a small one. Checkpoint::dump() then writes the file at most once per
dump interval (60 s), so almost all of that work was discarded.

Add Checkpoint::isDumpDue() and only save (and dump) when the dump will
write. Nothing reads these keys of the in-memory checkpoint mid-run:
the boot trees restore only the model, which neither IQTree::save-
Checkpoint() nor a refining boot tree (on_refine_btree) writes, and the
MPI readers use their own Checkpoint objects. Whenever a file is
written it is written right after a full save, as before;
refined_samples is still recorded every iteration; and
refineBootTrees() and runTreeReconstruction() save the full state after
the loops, so the final checkpoint is unchanged.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QBkV69MxCAg5qwKtaWSJ2d
---
 tree/iqtree.cpp      | 18 ++++++++++++++----
 utils/checkpoint.cpp |  4 ++++
 utils/checkpoint.h   |  5 +++++
 3 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/tree/iqtree.cpp b/tree/iqtree.cpp
index b5053580..f6347eae 100644
--- a/tree/iqtree.cpp
+++ b/tree/iqtree.cpp
@@ -2648,8 +2648,12 @@ double IQTree::doTreeSearch() {
 
         // print UFBoot trees every 10 iterations
 
-        saveCheckpoint();
-        checkpoint->dump();
+        // as in refineBootTrees(): only serialize the state when the dump will write it;
+        // runTreeReconstruction() saves the final state after the search
+        if (checkpoint->isDumpDue()) {
+            saveCheckpoint();
+            checkpoint->dump();
+        }
 
         if (bestcandidate_changed) {
             printBestCandidateTree();
@@ -3067,13 +3071,19 @@ void IQTree::refineBootTrees() {
             cout << sample+1 << " samples done" << endl;
         }
 
-        saveCheckpoint();
+        // Saving serializes every UFBoot tree, which costs about as much as refining one,
+        // and nothing reads the in-memory checkpoint before it is dumped (the full state is
+        // saved again after this loop), so only refresh it when the dump will write it.
+        bool dump_due = checkpoint->isDumpDue();
+        if (dump_due)
+            saveCheckpoint();
         checkpoint->startStruct("UFBoot");
         refined_samples = sample;
         CKP_SAVE(refined_samples);
         checkpoint->endStruct();
 
-        checkpoint->dump();
+        if (dump_due)
+            checkpoint->dump();
 
 	}
     
