From a85e52749827dc6fbced0c48417ce88171efde5a Mon Sep 17 00:00:00 2001
From: Alan Rockefeller <alanrockefeller@gmail.com>
Date: Fri, 9 Oct 2026 01:55:22 +0000
Subject: [PATCH 1/7] SPR: do not evaluate the likelihood that thorough mode
 throws away

In thorough SPR rounds best_reinsert_edge() called
corax_treeinfo_compute_loglh_flex() after every regraft and then
overwrote the result with the score returned by algo_optimize_bl_triplet(),
whose first step evaluates the likelihood on the same edge again. Only the
CLV updates of that call are needed.

corax_treeinfo_update_partials() does the same traversal, operations and
CLV updates without the edge evaluation. It is used only when thorough mode
is on, the improving-moves counter (the one consumer of the discarded score)
is NULL, and fast CLV updates are on, so the restore at the end of
best_reinsert_edge() still refreshes partition_loglh[] exactly as before.

Exactness: the skipped call reads CLVs, scalers and the p-matrix and writes
only partition_loglh[] (and per-site buffers, NULL here); no later
computation reads its result. Output is byte-identical.

Measured: the edge evaluation plus its log() calls were ~11% of a
bootstrap-dominated run (fzc7, 101 taxa, GTR+G).

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/corax/optimize/spr_round.c | 11 +++++++++--
 src/corax/tree/treeinfo.c      | 32 ++++++++++++++++++++++++++------
 src/corax/tree/treeinfo.h      |  3 +++
 3 files changed, 38 insertions(+), 8 deletions(-)

diff --git a/src/corax/optimize/spr_round.c b/src/corax/optimize/spr_round.c
index 2c28c82..850de60 100644
--- a/src/corax/optimize/spr_round.c
+++ b/src/corax/optimize/spr_round.c
@@ -797,8 +797,15 @@ static int best_reinsert_edge(corax_treeinfo_t            *treeinfo,
     algo_update_pmatrix(treeinfo, p_edge->next);
     algo_update_pmatrix(treeinfo, p_edge->next->next);
 
-    /* re-compute invalid CLVs, and get tree logLH */
-    loglh = corax_treeinfo_compute_loglh_flex(treeinfo, 1, 0);
+    /* re-compute invalid CLVs, and get tree logLH.
+     * In thorough mode the triplet optimization below starts by evaluating
+     * the same edge and its result replaces this score, so unless the
+     * improving-moves counter needs it, only the CLVs are brought up to date */
+    if (params->thorough && !params->improving_moves_counter
+        && params->fast_clv_updates)
+      corax_treeinfo_update_partials(treeinfo, 1, 0);
+    else
+      loglh = corax_treeinfo_compute_loglh_flex(treeinfo, 1, 0);
 
     if(params->improving_moves_counter && (loglh > init_loglh)) (*params->improving_moves_counter)++;
 
diff --git a/src/corax/tree/treeinfo.c b/src/corax/tree/treeinfo.c
index 83c4a8b..a2f9a08 100644
--- a/src/corax/tree/treeinfo.c
+++ b/src/corax/tree/treeinfo.c
@@ -976,7 +976,8 @@ static double treeinfo_compute_loglh(corax_treeinfo_t *treeinfo,
                                      int               incremental,
                                      int               update_pmatrices,
                                      double **persite_lnl,
-                                     double **sitecat_lh) {
+                                     double **sitecat_lh,
+                                     int               compute_lh) {
   /* tree root must be an inner node! */
   assert(!CORAX_UTREE_IS_TIP(treeinfo->root));
 
@@ -1055,7 +1056,7 @@ static double treeinfo_compute_loglh(corax_treeinfo_t *treeinfo,
     if (!treeinfo->partitions[p])
     {
       /* this partition will be computed by another thread(s) */
-      treeinfo->partition_loglh[p] = 0.0;
+      if (compute_lh) treeinfo->partition_loglh[p] = 0.0;
       continue;
     }
 
@@ -1070,6 +1071,8 @@ static double treeinfo_compute_loglh(corax_treeinfo_t *treeinfo,
     corax_treeinfo_validate_clvs(
         treeinfo, treeinfo->travbuffer, traversal_size);
 
+    if (!compute_lh) continue;
+
     /* compute the likelihood on an edge of the unrooted tree by specifying
        the CLV indices at the two end-point of the branch, the probability
        matrix index for the concrete branch length, and the index of the model
@@ -1086,6 +1089,13 @@ static double treeinfo_compute_loglh(corax_treeinfo_t *treeinfo,
                                                  sitecat_lh ? sitecat_lh[p] : NULL);
   }
 
+  if (!compute_lh)
+  {
+    /* CLVs only: partition_loglh[] is left as it was */
+    corax_treeinfo_set_active_partition(treeinfo, old_active_partition);
+    return 0.0;
+  }
+
   /* sum up likelihood from all threads */
   if (treeinfo->parallel_reduce_cb)
   {
@@ -1110,25 +1120,35 @@ static double treeinfo_compute_loglh(corax_treeinfo_t *treeinfo,
 CORAX_EXPORT double corax_treeinfo_compute_loglh(corax_treeinfo_t *treeinfo,
                                                  int               incremental)
 {
-  return treeinfo_compute_loglh(treeinfo, incremental, 1, NULL,NULL);
+  return treeinfo_compute_loglh(treeinfo, incremental, 1, NULL, NULL, 1);
 }
 
 CORAX_EXPORT double corax_treeinfo_compute_loglh_flex(
     corax_treeinfo_t *treeinfo, int incremental, int update_pmatrices)
 {
-  return treeinfo_compute_loglh(treeinfo, incremental, update_pmatrices, NULL,NULL);
+  return treeinfo_compute_loglh(treeinfo, incremental, update_pmatrices, NULL, NULL, 1);
 }
 
 CORAX_EXPORT double corax_treeinfo_compute_loglh_persite(
     corax_treeinfo_t *treeinfo, int incremental, int update_matrices, double **persite_lnl)
 {
-  return treeinfo_compute_loglh(treeinfo, incremental, update_matrices, persite_lnl,NULL);
+  return treeinfo_compute_loglh(treeinfo, incremental, update_matrices, persite_lnl, NULL, 1);
 }
 
 // TODO: implement for all kernels
 CORAX_EXPORT double corax_treeinfo_compute_loglh_sitecat(
   corax_treeinfo_t *treeinfo, int incremental, int update_matrices, double **sitecat_lh) {
-  return treeinfo_compute_loglh(treeinfo, incremental, update_matrices, NULL, sitecat_lh);
+  return treeinfo_compute_loglh(treeinfo, incremental, update_matrices, NULL, sitecat_lh, 1);
+}
+
+/* Same traversal and CLV updates as corax_treeinfo_compute_loglh_flex(), but
+   without evaluating the likelihood at the root edge. For callers that need
+   the CLVs up to date and will compute the score themselves. */
+CORAX_EXPORT void corax_treeinfo_update_partials(corax_treeinfo_t *treeinfo,
+                                                 int               incremental,
+                                                 int               update_pmatrices)
+{
+  treeinfo_compute_loglh(treeinfo, incremental, update_pmatrices, NULL, NULL, 0);
 }
 
 CORAX_EXPORT
diff --git a/src/corax/tree/treeinfo.h b/src/corax/tree/treeinfo.h
index e1c6c13..ad1113c 100644
--- a/src/corax/tree/treeinfo.h
+++ b/src/corax/tree/treeinfo.h
@@ -265,6 +265,9 @@ extern "C"
   CORAX_EXPORT double corax_treeinfo_compute_loglh_flex(
       corax_treeinfo_t *treeinfo, int incremental, int update_pmatrices);
 
+  CORAX_EXPORT void corax_treeinfo_update_partials(
+      corax_treeinfo_t *treeinfo, int incremental, int update_pmatrices);
+
   CORAX_EXPORT double corax_treeinfo_compute_loglh_persite(
       corax_treeinfo_t *treeinfo, int incremental, int update_matrices, double **persite_lnl);
 
-- 
