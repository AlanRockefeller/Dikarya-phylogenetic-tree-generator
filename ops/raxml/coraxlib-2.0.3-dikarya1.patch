index 60d22d6..edda6f8 100644
--- a/src/corax/core/partition.c
+++ b/src/corax/core/partition.c
@@ -111,6 +111,8 @@ static void dealloc_partition_data(corax_partition_t *partition)
     free(repeats->pernode_ids);
     free(repeats->perscale_ids);
     free(repeats->pernode_allocated_clvs);
+    free(repeats->pernode_clv_capacity);
+    free(repeats->perscale_capacity);
     free(repeats->lookup_buffer);
     free(repeats->toclean_buffer);
     free(repeats->id_site_buffer);
diff --git a/src/corax/core/repeats.c b/src/corax/core/repeats.c
index 20bc536..aa59bd8 100644
--- a/src/corax/core/repeats.c
+++ b/src/corax/core/repeats.c
@@ -153,6 +153,9 @@ CORAX_EXPORT int corax_repeats_initialize(corax_partition_t *partition)
       calloc(partition->scale_buffers, sizeof(unsigned int));
   repeats->pernode_allocated_clvs =
       calloc(partition->nodes, sizeof(unsigned int));
+  repeats->pernode_clv_capacity = calloc(partition->nodes, sizeof(unsigned int));
+  repeats->perscale_capacity =
+      calloc(partition->scale_buffers, sizeof(unsigned int));
   repeats->lookup_buffer      = 0;
   repeats->lookup_buffer_size = 0;
   repeats->toclean_buffer     = malloc(sites_alloc * sizeof(unsigned int));
@@ -163,6 +166,7 @@ CORAX_EXPORT int corax_repeats_initialize(corax_partition_t *partition)
                           partition->alignment);
   repeats->charmap = calloc(CORAX_ASCII_SIZE, sizeof(char));
   if (!(repeats->pernode_ids && repeats->pernode_allocated_clvs
