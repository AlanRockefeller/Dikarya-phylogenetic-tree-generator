diff --git a/src/corax/kernel/matvec_4x4_cols.h b/src/corax/kernel/matvec_4x4_cols.h
new file mode 100644
index 0000000..2744a41
--- /dev/null
+++ b/src/corax/kernel/matvec_4x4_cols.h
@@ -0,0 +1,70 @@
+/*
+    4x4 matrix-vector products from matrix columns, for the 4-state kernels.
+
+    The row-wise kernels compute M*v as four elementwise products row_i * v
+    and reduce each with unpacklo/unpackhi + add (pairing elements 0,1 and
+    2,3) followed by permute2f128/blend + add. Element i of the result is
+    therefore (m_i0*v0 + m_i1*v1) + (m_i2*v2 + m_i3*v3). Computing it from the
+    columns of M as (c0*v0 + c1*v1) + (c2*v2 + c3*v3) gives the same products
+    and pairs the additions the same way; IEEE addition is commutative, so the
+    result is bitwise identical, without four port-5 shuffles per product.
+
+    Include from a file compiled with AVX enabled.
+*/
+#ifndef CORAX_KERNEL_MATVEC_4X4_COLS_H_
+#define CORAX_KERNEL_MATVEC_4X4_COLS_H_
+
+#include <immintrin.h>
+
+/* Columns of a row-major 4x4 matrix: c[j] = (m[0][j], m[1][j], m[2][j], m[3][j]). */
+static inline void corax_transpose_4x4_avx(const double *m, __m256d *c)
+{
+  __m256d r0 = _mm256_loadu_pd(m);
+  __m256d r1 = _mm256_loadu_pd(m + 4);
+  __m256d r2 = _mm256_loadu_pd(m + 8);
+  __m256d r3 = _mm256_loadu_pd(m + 12);
+  __m256d t0 = _mm256_unpacklo_pd(r0, r1);
+  __m256d t1 = _mm256_unpackhi_pd(r0, r1);
+  __m256d t2 = _mm256_unpacklo_pd(r2, r3);
+  __m256d t3 = _mm256_unpackhi_pd(r2, r3);
+  c[0]       = _mm256_permute2f128_pd(t0, t2, 0x20);
+  c[1]       = _mm256_permute2f128_pd(t1, t3, 0x20);
+  c[2]       = _mm256_permute2f128_pd(t0, t2, 0x31);
+  c[3]       = _mm256_permute2f128_pd(t1, t3, 0x31);
+}
+
+/* M*v, products by multiplication (as in the kernels that use _mm256_mul_pd). */
+static inline __m256d corax_matvec_cols_4x4_avx(const __m256d *c, const double *v)
+{
+  __m256d p0 = _mm256_mul_pd(c[0], _mm256_broadcast_sd(v));
+  __m256d p1 = _mm256_mul_pd(c[1], _mm256_broadcast_sd(v + 1));
+  __m256d p2 = _mm256_mul_pd(c[2], _mm256_broadcast_sd(v + 2));
+  __m256d p3 = _mm256_mul_pd(c[3], _mm256_broadcast_sd(v + 3));
+  return _mm256_add_pd(_mm256_add_pd(p0, p1), _mm256_add_pd(p2, p3));
+}
+
+/* M*v for kernels that form each product as 0 + m*v (an add to a zeroed
+ * accumulator), which turns a -0 product into +0. With canon(x) = x + 0,
+ * canon(a) + canon(b) == canon(a + b) for all doubles under round-to-nearest,
+ * so adding +0 once to the finished sum gives the same bits. */
+static inline __m256d corax_matvec_cols_4x4_zadd_avx(const __m256d *c, const double *v)
+{
+  return _mm256_add_pd(corax_matvec_cols_4x4_avx(c, v), _mm256_setzero_pd());
+}
+
+#ifdef __FMA__
+/* M*v for kernels that form each product as fma(m, v, 0) (an FMA into a
+ * zeroed accumulator). That is not always canon(m*v) -- an exact product
+ * that underflows to -0 stays -0 -- so each product is formed the same way. */
+static inline __m256d corax_matvec_cols_4x4_fma0_avx(const __m256d *c, const double *v)
+{
+  const __m256d z = _mm256_setzero_pd();
+  __m256d p0 = _mm256_fmadd_pd(c[0], _mm256_broadcast_sd(v), z);
+  __m256d p1 = _mm256_fmadd_pd(c[1], _mm256_broadcast_sd(v + 1), z);
+  __m256d p2 = _mm256_fmadd_pd(c[2], _mm256_broadcast_sd(v + 2), z);
+  __m256d p3 = _mm256_fmadd_pd(c[3], _mm256_broadcast_sd(v + 3), z);
+  return _mm256_add_pd(_mm256_add_pd(p0, p1), _mm256_add_pd(p2, p3));
+}
+#endif
+
+#endif
