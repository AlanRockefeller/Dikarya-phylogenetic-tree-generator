From f0d37e2eba843653b881f4f39dfefda1398dea5d Mon Sep 17 00:00:00 2001
From: Alan Rockefeller <alanrockefeller@gmail.com>
Date: Fri, 9 Oct 2026 06:02:56 +0000
Subject: [PATCH 6/7] AVX2 edge log-likelihood (site repeats): 4-state path

DNA with site repeats evaluated the edge log-likelihood with the generic
AVX2 kernel (~16% of a run plus 7% in log()). A 4-state path does the same
arithmetic with the p-matrix product from columns (FMA into a zeroed
accumulator, per product, as before), takes the per-category frequency
vector and invariant proportion out of the site loop, and processes sites
in chunks of 64: first each site's likelihood terms, then the logs and the
sum in site order. The old loop issued ~200 uops and a log() call per site,
too much for the out-of-order window to overlap consecutive sites.

Exactness: every per-site value comes from the same operations in the same
order (the scalar code is unchanged, so gcc contracts the same expressions
into FMAs), and the log-likelihood is summed in the same site order.
Harness: 4000 random cases (invariant sites, per-rate and per-site scaling,
per-site and per-category outputs, pattern weights): return value and
outputs all identical. ~1.6x faster per call.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/corax/kernel/avx2/core_likelihood_avx2.c | 254 +++++++++++++++++++
 1 file changed, 254 insertions(+)

diff --git a/src/corax/kernel/avx2/core_likelihood_avx2.c b/src/corax/kernel/avx2/core_likelihood_avx2.c
index a77c98a..6ab25c9 100644
--- a/src/corax/kernel/avx2/core_likelihood_avx2.c
+++ b/src/corax/kernel/avx2/core_likelihood_avx2.c
@@ -20,6 +20,7 @@
 */
 
 #include "corax/corax.h"
+#include "corax/kernel/matvec_4x4_cols.h"
 #include <limits.h>
 
 CORAX_EXPORT double
@@ -689,6 +690,238 @@ corax_core_edge_loglikelihood_ii_avx2(unsigned int         states,
   return logl;
 }
 
+/* 4-state specialization of corax_core_edge_loglikelihood_repeats_generic_avx2():
+ * the same arithmetic, operation for operation, with the p-matrix product
+ * computed from the matrix columns (see matvec_4x4_cols.h) instead of a
+ * row-wise product followed by a 4x4 transpose-add. */
+static double edge_loglikelihood_repeats_4x4_avx2(
+    unsigned int         sites,
+    unsigned int         rate_cats,
+    const double *       parent_clv,
+    const unsigned int * parent_scaler,
+    const double *       child_clv,
+    const unsigned int * child_scaler,
+    const double *       pmatrix,
+    const double *const *frequencies,
+    const double *       rate_weights,
+    const unsigned int * pattern_weights,
+    const double *       invar_proportion,
+    const int *          invar_indices,
+    const unsigned int * freqs_indices,
+    double *             persite_lnl,
+    double *             sitecat_lh,
+    const unsigned int * parent_site_id,
+    const unsigned int * child_site_id,
+    unsigned int         attrib)
+{
+  unsigned int n, i;
+  double       logl       = 0;
+  double       prop_invar = 0;
+
+  const double *freqs = NULL;
+
+  double terma, terma_r, terminv;
+  double site_lk, inv_site_lk;
+
+  const unsigned int states_padded = 4;
+  unsigned int       span          = states_padded * rate_cats;
+
+  __m256d xmm0, xmm1, xmm2;
+
+  /* scaling stuff */
+  unsigned int  site_scalings;
+  unsigned int *rate_scalings    = NULL;
+  int           per_rate_scaling = (attrib & CORAX_ATTRIB_RATE_SCALERS) ? 1 : 0;
+
+  /* powers of scale threshold for undoing the scaling */
+  double scale_minlh[CORAX_SCALE_RATE_MAXDIFF];
+  if (per_rate_scaling || invar_proportion)
+  {
+    double scale_factor = 1.0;
+    for (i = 0; i < CORAX_SCALE_RATE_MAXDIFF; ++i)
+    {
+      scale_factor *= CORAX_SCALE_THRESHOLD;
+      scale_minlh[i] = scale_factor;
+    }
+  }
+  if (per_rate_scaling)
+  {
+    rate_scalings = (unsigned int *)calloc(rate_cats, sizeof(unsigned int));
+
+    if (!rate_scalings)
+    {
+      corax_set_error(CORAX_ERROR_MEM_ALLOC,
+                      "Cannot allocate space for rate scalers.");
+      return -INFINITY;
+    }
+  }
+
+  /* columns of the p-matrix of every rate category, and the per-category
+   * frequency vector and proportion of invariant sites (the same for every
+   * site) */
+  __m256d       pcol[4 * rate_cats];
+  const double *rate_freqs[rate_cats];
+  double        rate_pinv[rate_cats];
+  for (i = 0; i < rate_cats; ++i)
+  {
+    corax_transpose_4x4_avx(pmatrix + 16 * i, pcol + 4 * i);
+    rate_freqs[i] = frequencies[freqs_indices[i]];
+    rate_pinv[i]  = invar_proportion ? invar_proportion[freqs_indices[i]] : 0;
+  }
+
+  /* Sites are processed in chunks: first every site's likelihood terms (no
+   * calls, so consecutive sites overlap in the pipeline), then the logs and
+   * the sum, in site order. Each site's values come from exactly the same
+   * operations as before. */
+#define EDGE_4X4_CHUNK 64
+  double       chunk_terma[EDGE_4X4_CHUNK];
+  double       chunk_terminv[EDGE_4X4_CHUNK];
+  unsigned int chunk_scalings[EDGE_4X4_CHUNK];
+
+  unsigned int chunk_start;
+  for (chunk_start = 0; chunk_start < sites; chunk_start += EDGE_4X4_CHUNK)
+  {
+    unsigned int chunk_end = CORAX_MIN(sites, chunk_start + EDGE_4X4_CHUNK);
+
+    for (n = chunk_start; n < chunk_end; ++n)
+    {
+      unsigned int  pid  = CORAX_GET_ID(parent_site_id, n);
+      unsigned int  cid  = CORAX_GET_ID(child_site_id, n);
+      const double *clvp = &parent_clv[pid * span];
+      const double *clvc = &child_clv[cid * span];
+      terma              = 0;
+      terminv            = 0;
+
+      if (per_rate_scaling)
+      {
+        /* compute minimum per-rate scaler -> common per-site scaler */
+        site_scalings = UINT_MAX;
+        for (i = 0; i < rate_cats; ++i)
+        {
+          rate_scalings[i] =
+              (parent_scaler) ? parent_scaler[pid * rate_cats + i] : 0;
+          rate_scalings[i] +=
+              (child_scaler) ? child_scaler[cid * rate_cats + i] : 0;
+          if (rate_scalings[i] < site_scalings)
+            site_scalings = rate_scalings[i];
+        }
+
+        /* compute relative capped per-rate scalers */
+        for (i = 0; i < rate_cats; ++i)
+        {
+          rate_scalings[i] = CORAX_MIN(rate_scalings[i] - site_scalings,
+                                       CORAX_SCALE_RATE_MAXDIFF);
+        }
+      }
+      else
+      {
+        /* count number of scaling factors to account for */
+        site_scalings = (parent_scaler) ? parent_scaler[pid] : 0;
+        site_scalings += (child_scaler) ? child_scaler[cid] : 0;
+      }
+
+      for (i = 0; i < rate_cats; ++i)
+      {
+        freqs   = rate_freqs[i];
+        terma_r = 0;
+
+        /* P * clvc: each product is an FMA into a zeroed accumulator */
+        xmm0 = corax_matvec_cols_4x4_fma0_avx(pcol + 4 * i, clvc);
+
+        /* multiply with frequencies */
+        xmm1 = _mm256_load_pd(freqs);
+        xmm2 = _mm256_mul_pd(xmm0, xmm1);
+
+        /* multiply with clvp */
+        xmm0 = _mm256_load_pd(clvp);
+        xmm1 = _mm256_mul_pd(xmm2, xmm0);
+
+        /* add up the elements of xmm1 */
+        xmm0 = _mm256_hadd_pd(xmm1, xmm1);
+        terma_r += ((double *)&xmm0)[0] + ((double *)&xmm0)[2];
+
+        clvp += states_padded;
+
+        if (sitecat_lh != NULL) {
+          *sitecat_lh = terma_r;
+          ++sitecat_lh;
+        }
+
+        /* apply per-rate scalers, if necessary */
+        if (rate_scalings && rate_scalings[i] > 0)
+        {
+          terma_r *= scale_minlh[rate_scalings[i] - 1];
+        }
+
+        /* account for invariant sites */
+        prop_invar = rate_pinv[i];
+        if (prop_invar > 0)
+        {
+          terma += rate_weights[i] * terma_r * (1. - prop_invar);
+          if (invar_indices[n] != -1)
+          {
+            freqs       = rate_freqs[i];
+            inv_site_lk = freqs[invar_indices[n]];
+            terminv += rate_weights[i] * inv_site_lk * prop_invar;
+          }
+        }
+        else
+        {
+          terma += terma_r * rate_weights[i];
+        }
+
+        clvc += states_padded;
+      }
+
+      chunk_terma[n - chunk_start]    = terma;
+      chunk_terminv[n - chunk_start]  = terminv;
+      chunk_scalings[n - chunk_start] = site_scalings;
+    }
+
+    for (n = chunk_start; n < chunk_end; ++n)
+    {
+      terma         = chunk_terma[n - chunk_start];
+      terminv       = chunk_terminv[n - chunk_start];
+      site_scalings = chunk_scalings[n - chunk_start];
+
+      /* compute site log-likelihood and scale if necessary */
+      if (site_scalings)
+      {
+        if (terminv > 0.)
+        {
+          /* IMPORTANT: undoing the scaling for non-variant likelihood term
+           * only! */
+          unsigned int capped_scalings =
+              CORAX_MIN(site_scalings, CORAX_SCALE_RATE_MAXDIFF);
+          double scale_factor = scale_minlh[capped_scalings - 1];
+          site_lk             = log(terma * scale_factor + terminv);
+        }
+        else
+        {
+          site_lk = log(terma);
+          site_lk += site_scalings * log(CORAX_SCALE_THRESHOLD);
+        }
+      }
+      else
+      {
+        site_lk = log(terma + terminv);
+      }
+
+      site_lk *= pattern_weights[n];
+
+      /* store per-site log-likelihood */
+      if (persite_lnl) persite_lnl[n] = site_lk;
+
+      logl += site_lk;
+    }
+  }
+#undef EDGE_4X4_CHUNK
+
+  if (rate_scalings) free(rate_scalings);
+
+  return logl;
+}
+
 CORAX_EXPORT
 double corax_core_edge_loglikelihood_repeats_generic_avx2(
     unsigned int         states,
@@ -715,6 +948,27 @@ double corax_core_edge_loglikelihood_repeats_generic_avx2(
 {
   CORAX_UNUSED(child_sites);
   CORAX_UNUSED(bclv);
+
+  if (states == 4)
+    return edge_loglikelihood_repeats_4x4_avx2(sites,
+                                               rate_cats,
+                                               parent_clv,
+                                               parent_scaler,
+                                               child_clv,
+                                               child_scaler,
+                                               pmatrix,
+                                               frequencies,
+                                               rate_weights,
+                                               pattern_weights,
+                                               invar_proportion,
+                                               invar_indices,
+                                               freqs_indices,
+                                               persite_lnl,
+                                               sitecat_lh,
+                                               parent_site_id,
+                                               child_site_id,
+                                               attrib);
+
   unsigned int n, i, j, k;
   double       logl       = 0;
   double       prop_invar = 0;
