+    // avoid valgrind errors
+    memset(partition->clv[parent], 0, sites_to_alloc);
+    if (repeats->pernode_clv_capacity)
+      repeats->pernode_clv_capacity[parent] = sites_to_alloc;
   }
+#ifdef CORAX_REPEATS_POISON_TEST
+  else
+  {
+    /* reused buffer: fill with junk to prove nothing reads it before writing */
+    size_t n = (size_t)sites_to_alloc * partition->states_padded
+               * partition->rate_cats;
+    for (size_t k = 0; k < n; ++k) partition->clv[parent][k] = NAN;
+    memset(id_site[parent], 0xA5, sites_to_alloc * sizeof(unsigned int));
+  }
+#endif
   // reallocate scales
   if (CORAX_SCALE_BUFFER_NONE != scaler_index)
   {
     unsigned int scaler_size = sites_to_alloc;
     if (partition->attributes & CORAX_ATTRIB_RATE_SCALERS)
       scaler_size *= partition->rate_cats;
-    free(partition->scale_buffer[scaler_index]);
-    partition->scale_buffer[scaler_index] =
-        calloc(scaler_size, sizeof(unsigned int));
+    if (!repeats->perscale_capacity
+        || scaler_size > repeats->perscale_capacity[scaler_index])
+    {
+      free(partition->scale_buffer[scaler_index]);
+      partition->scale_buffer[scaler_index] =
+          calloc(scaler_size, sizeof(unsigned int));
+      if (repeats->perscale_capacity)
+        repeats->perscale_capacity[scaler_index] =
+            partition->scale_buffer[scaler_index] ? scaler_size : 0;
+    }
+#ifdef CORAX_REPEATS_POISON_TEST
