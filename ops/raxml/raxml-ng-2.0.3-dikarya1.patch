From 28eebdb6d858251d8db49676581f2fd0ed044823 Mon Sep 17 00:00:00 2001
From: Alan Rockefeller <alanrockefeller@gmail.com>
Date: Fri, 9 Oct 2026 01:55:36 +0000
Subject: [PATCH 1/2] autoMRE: count split support per subset with packed bits
 and popcount

The bootstopping test runs 1000 permutations every 50 bootstrap trees; for
each permutation and each split seen so far it counted the trees of each
random half that contain the split by walking a std::vector<bool> one tree
at a time (permutations x splits x trees single-bit reads). On a 101-taxon
job with 1000 replicates this was a ~7 s pause after every 50th replicate,
during which the other coarse-grained workers wait at the barrier.

Split occurrences are now packed 64 trees to a word, the first half of each
permutation is a bit mask, and cnt1 = popcount(occ & mask),
cnt2 = popcount(occ) - cnt1. A popcnt-target clone is selected at run time,
so the portable build still runs on CPUs without POPCNT.

Exactness: the two counts are the same integers as before (every occurrence
is in exactly one half); the shuffles, the sorts in mre() and everything
downstream are unchanged. Output is byte-identical.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/bootstrap/BootstopCheck.cpp | 71 ++++++++++++++++++++++++---------
 src/bootstrap/BootstopCheck.hpp |  4 +-
 2 files changed, 55 insertions(+), 20 deletions(-)

diff --git a/src/bootstrap/BootstopCheck.cpp b/src/bootstrap/BootstopCheck.cpp
index 4160af2..b7afe4b 100644
--- a/src/bootstrap/BootstopCheck.cpp
+++ b/src/bootstrap/BootstopCheck.cpp
@@ -2,6 +2,32 @@
 
 using namespace std;
 
+/* Number of trees in the first subset (perm[j] even) and in total among the
+ * trees in which a split occurs: popcount over the packed occurrence bits. */
+static inline void count_split_subsets(const uint64_t * occ, const uint64_t * half1,
+                                       size_t words, unsigned int& cnt1,
+                                       unsigned int& total)
+{
+  unsigned int c1 = 0, t = 0;
+  for (size_t w = 0; w < words; ++w)
+  {
+    c1 += (unsigned int) __builtin_popcountll(occ[w] & half1[w]);
+    t  += (unsigned int) __builtin_popcountll(occ[w]);
+  }
+  cnt1 = c1;
+  total = t;
+}
+
+#if defined(__x86_64__) && defined(__GNUC__)
+__attribute__((target("popcnt")))
+static void count_split_subsets_popcnt(const uint64_t * occ, const uint64_t * half1,
+                                       size_t words, unsigned int& cnt1,
+                                       unsigned int& total)
+{
+  count_split_subsets(occ, half1, words, cnt1, total);
+}
+#endif
+
 BootstopCheck::BootstopCheck(size_t max_bs_trees)
 {
   _max_bs_trees = max_bs_trees;
@@ -50,11 +76,9 @@ void BootstopCheck::add_bootstrap_tree(const Tree& tree)
 
     /* new split -> create bit vector with tree occurence flags */
     if (e->bip_number ==_split_occurence.size())
-      _split_occurence.emplace_back(bitVector(_max_bs_trees));
-//        _split_occurence.emplace_back(bitVector());
+      _split_occurence.emplace_back(occurenceVector((_max_bs_trees + 63) / 64, 0));
 
-    _split_occurence[e->bip_number][_num_bs_trees] = true;
-//    _split_occurence[e->bip_number].set(_num_bs_trees);
+    _split_occurence[e->bip_number][_num_bs_trees / 64] |= (uint64_t) 1 << (_num_bs_trees % 64);
   }
 
   corax_utree_split_destroy(splits);
@@ -126,6 +150,16 @@ bool BootstopCheckMRE::check_convergence(RandomGenerator& gen)
 
   auto splits_all = all_splits();
 
+  /* only the words that can hold a bit for one of the trees added so far */
+  const size_t words = (_num_bs_trees + 63) / 64;
+  occurenceVector half1(words);
+
+  auto count_subsets = count_split_subsets;
+#if defined(__x86_64__) && defined(__GNUC__)
+  if (__builtin_cpu_supports("popcnt"))
+    count_subsets = count_split_subsets_popcnt;
+#endif
+
   /* init permutation array with 1:1 mapping */
   for (size_t i = 0; i < _num_bs_trees; ++i)
     perm[i] = (unsigned int) i;
@@ -135,26 +169,25 @@ bool BootstopCheckMRE::check_convergence(RandomGenerator& gen)
     /* shuffle tree indices to divide trees into 2 random subsets */
     std::shuffle(perm.begin(), perm.end(), gen);
 
+    /* tree j goes to the first subset iff perm[j] is even */
+    std::fill(half1.begin(), half1.end(), 0);
+    for(size_t j = 0; j < _num_bs_trees; j++)
+    {
+      if (perm[j] % 2 == 0)
+        half1[j / 64] |= (uint64_t) 1 << (j % 64);
+    }
+
     /* iterate over all splits in the hashtable */
     for (const auto e: splits_all)
     {
-      /* for each split, compute how many times it occurred in both tree subsets */
-      unsigned int cnt1 = 0;
-      unsigned int cnt2 = 0;
-      const auto& occ = _split_occurence[e->bip_number];
-      for(size_t j = 0; j < _num_bs_trees; j++)
-      {
-        if (occ[j])
-        {
-          if(perm[j] % 2 == 0)
-            cnt1++;
-          else
-            cnt2++;
-        }
-      }
+      /* for each split, compute how many times it occurred in both tree subsets:
+       * every occurrence is in exactly one of the two subsets */
+      unsigned int cnt1, total;
+      count_subsets(_split_occurence[e->bip_number].data(), half1.data(), words,
+                    cnt1, total);
 
       support1[e->bip_number] = cnt1;
-      support2[e->bip_number] = cnt2;
+      support2[e->bip_number] = total - cnt1;
     }
 
     /* build MRE consensus trees for both subsets */
diff --git a/src/bootstrap/BootstopCheck.hpp b/src/bootstrap/BootstopCheck.hpp
index 46d7a90..bfa34fc 100644
--- a/src/bootstrap/BootstopCheck.hpp
+++ b/src/bootstrap/BootstopCheck.hpp
@@ -5,6 +5,8 @@
 #include "../Tree.hpp"
 
 typedef std::vector<bool> bitVector;
+/* one bit per bootstrap tree, packed into 64-bit words */
+typedef std::vector<uint64_t> occurenceVector;
 typedef std::vector<bitv_hash_entry_t *> splitEntryVector;
 
 //typedef std::bitset<1000> bitVector;
@@ -41,7 +43,7 @@ protected:
   size_t _num_bs_trees;
   size_t _max_bs_trees;
   bitv_hashtable_t * _pll_splits_hash;
-  std::vector<bitVector> _split_occurence;
+  std::vector<occurenceVector> _split_occurence;
 
   splitEntryVector all_splits();
 
-- 
2.43.0


