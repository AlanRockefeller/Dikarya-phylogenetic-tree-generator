From fd88546f062857f0d9851df527afa0fcb18cd211 Mon Sep 17 00:00:00 2001
From: Alan Rockefeller <alanrockefeller@gmail.com>
Date: Fri, 9 Oct 2026 21:28:12 +0000
Subject: [PATCH 2/4] LogDirPrior: remember log(branch length) per node

With the default branch-length prior (gammadir) every branch-length and
topology move calls LogDirPrior twice, and each call takes log() of every
branch length -- 2n-3 logs per call, although a move changes a few
branches. Each TreeNode now keeps log(length) together with the length it
was computed from; LogDirPrior recomputes it only when the length differs.

Exact: the cached value is the same log() of the same double (two equal
doubles can differ only as +0/-0, whose logs are equal), and the sum is
formed in the same order. Nodes are allocated with calloc, so the cache
starts invalid; the one struct copy of nodes (utils.c) copies the cached
pair together with the length it belongs to.

About 3% of a 129-taxon run (LogDirPrior plus its log calls).
---
 src/bayes.h |  3 +++
 src/mcmc.c  | 18 +++++++++++++++++-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/bayes.h b/src/bayes.h
index 53e1813..07259a7 100644
--- a/src/bayes.h
+++ b/src/bayes.h
@@ -587,6 +587,9 @@ typedef struct node
     MrBFlt          nodeDepth;              /*!< node depth (height)                        */
     MrBFlt          age;                    /*!< age of node                                */
     Calibration     *calibration;           /*!< pointer to calibration data                */
+    MrBFlt          logLength;              /*!< log(lengthOfLog), cached by LogDirPrior    */
+    MrBFlt          lengthOfLog;            /*!< length that logLength was computed from    */
+    int             logLengthValid;         /*!< is logLength set? (nodes start zeroed)     */
     }
     TreeNode;
 
diff --git a/src/mcmc.c b/src/mcmc.c
index 324ce20..63cff85 100644
--- a/src/mcmc.c
+++ b/src/mcmc.c
@@ -7752,6 +7752,22 @@ MrBFlt LogOmegaPrior (MrBFlt w1, MrBFlt w2, MrBFlt w3)
 /* external (tip): 1, internal: 0 */
 #define IsTip(Node) (Node->index < numTaxa || (Node->anc)->index < numTaxa)
 
+/* log(p->length), remembered per node: LogDirPrior sums it over every branch
+   twice per branch-length or topology move, and most branches have not
+   changed. The value is the same log() of the same length, so the sum is
+   unchanged; a length equal to the cached one is the same number. */
+static MrBFlt LogLength (TreeNode *p)
+{
+    if (p->logLengthValid == NO || p->lengthOfLog != p->length)
+        {
+        p->logLength = log (p->length);
+        p->lengthOfLog = p->length;
+        p->logLengthValid = YES;
+        }
+    return p->logLength;
+}
+
+
 MrBFlt LogDirPrior (Tree *t, ModelParams *mp, int PV)
 {
     /* ln prior prob. under Dirichlet priors and twoExp prior
@@ -7783,7 +7799,7 @@ MrBFlt LogDirPrior (Tree *t, ModelParams *mp, int PV)
             p = t->allDownPass[i];
             treeL += p->length;
             nb[IsTip(p)]++;
-            tb[IsTip(p)] += log(p->length);
+            tb[IsTip(p)] += LogLength(p);
             }
         lnprior += (a-1)*tb[1] + (a*c -1)*tb[0];
         if (PV == 2)
