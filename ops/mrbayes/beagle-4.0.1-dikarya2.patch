+/* rescalePartials for patterns [startPattern, endPattern): the maxima and
+   the 1/max multiply are vectorized, the rest is the scalar loop's code. */
+BEAGLE_CPU_TEMPLATE
+void BeagleCPU4StateImpl<BEAGLE_CPU_GENERIC>::dkRescalePartialsRange(REALTYPE* destP,
+                                                                     REALTYPE* scaleFactors,
+                                                                     REALTYPE* cumulativeScaleFactors,
+                                                                     int startPattern,
+                                                                     int endPattern) {
+#ifdef BEAGLE_DIKARYA_AVX
+    bool useLogScalars = kFlags & BEAGLE_FLAG_SCALERS_LOG;
+    const int chunk = 256;
+    float maxima[chunk], oneOverMaxima[chunk];
+    for (int k0 = startPattern; k0 < endPattern; k0 += chunk) {
+        const int n = (endPattern - k0 < chunk ? endPattern - k0 : chunk);
+        dk::patternMaxima(maxima, (const float*) destP + 4 * k0, kCategoryCount,
+                          kPaddedPatternCount, n);
+        for (int i = 0; i < n; i++) {
+            if (maxima[i] == 0)
+                maxima[i] = 1.0f;
+            oneOverMaxima[i] = 1.0f / maxima[i];
+        }
+        dk::scalePatterns((float*) destP + 4 * k0, oneOverMaxima, kCategoryCount,
+                          kPaddedPatternCount, n);
+        for (int i = 0; i < n; i++) {
+            const int k = k0 + i;
+            const REALTYPE max = maxima[i];
+            if (useLogScalars) {
+                REALTYPE logMax = log(max);
+                scaleFactors[k] = logMax;
+                if( cumulativeScaleFactors != NULL )
+                    cumulativeScaleFactors[k] += logMax;
+            } else {
+                scaleFactors[k] = max;
+                if( cumulativeScaleFactors != NULL )
+                    cumulativeScaleFactors[k] += log(max);
+            }
+        }
+    }
+    dk::opState().outMaySub = dk::subnormalMask((const float*) destP, kCategoryCount,
+                                                kPaddedPatternCount, startPattern, endPattern);
+#endif
+}
