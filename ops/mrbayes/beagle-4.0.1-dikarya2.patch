diff --git a/libhmsbeagle/CPU/DikaryaAVX.h b/libhmsbeagle/CPU/DikaryaAVX.h
new file mode 100644
index 00000000..8a611a73
--- /dev/null
+++ b/libhmsbeagle/CPU/DikaryaAVX.h
@@ -0,0 +1,370 @@
+/*
+ *  DikaryaAVX.h
+ *
+ *  AVX2 versions of the single-precision 4-state CPU kernels
+ *  (BeagleCPU4StateImpl<float, 1, 0>) that give bit-for-bit the same results as
+ *  the scalar code they replace.
+ *
+ *  Exactness rules followed throughout:
+ *   - every value is produced by the same IEEE single-precision operations, on
+ *     the same operands, in the same order as the scalar expression it replaces
+ *     (only commuted, which is exact: a*b == b*a and a+b == b+a, NaN payloads
+ *     aside);
+ *   - no fused multiply-add: the functions are compiled for "avx2" only, never
+ *     "fma", so a separate multiply and add cannot be contracted;
+ *   - a sum that starts from a zeroed buffer starts from +0.0f here too, since
+ *     0 + x is not x when x is -0.
+ *
+ *  Layout (as in the scalar code): partials are [category][pattern][state],
+ *  category stride 4 * paddedPatternCount; a transition matrix is 4 rows of
+ *  OFFSET = 5 floats per category (row i = from-state i, column 4 = 1.0 for a
+ *  missing state). Two patterns are processed per 256-bit vector, one per
+ *  128-bit half, so every lane-crossing step is an in-lane permute.
+ */
+
+#ifndef __BeagleDikaryaAVX__
+#define __BeagleDikaryaAVX__
+
+#if defined(__x86_64__) && defined(__GNUC__)
+#define BEAGLE_DIKARYA_AVX 1
+#endif
+
+#ifdef BEAGLE_DIKARYA_AVX
+
+#include <immintrin.h>
+#include <cmath>
+#include <cstdlib>
+
+#define DK_TARGET __attribute__((target("avx2")))
+#define DK_INLINE inline __attribute__((always_inline))
+
+namespace beagle {
+namespace cpu {
+namespace dk {
+
+/* Kernels run only when the CPU has AVX2 and BEAGLE_DIKARYA_SCALAR is unset
+   (the latter forces the original scalar code, for A/B checks). */
+inline bool enabled() {
+    static const bool on = __builtin_cpu_supports("avx2") && getenv("BEAGLE_DIKARYA_SCALAR") == NULL;
+    return on;
+}
+
+/* c[j] = column j of a 4x5 row-major matrix, duplicated into both halves:
+   (m0j, m1j, m2j, m3j, m0j, m1j, m2j, m3j). */
+DK_TARGET DK_INLINE void loadColumns(const float* m, __m256 c[4]) {
+    for (int j = 0; j < 4; j++) {
+        const __m128 col = _mm_setr_ps(m[j], m[5 + j], m[10 + j], m[15 + j]);
+        c[j] = _mm256_insertf128_ps(_mm256_castps128_ps256(col), col, 1);
+    }
+}
+
+/* t[s] = column s of a 4x5 row-major matrix, s = 0..4 (4 = missing state). */
+DK_TARGET DK_INLINE void loadStateColumns(const float* m, __m128 t[5]) {
+    for (int s = 0; s < 5; s++)
+        t[s] = _mm_setr_ps(m[s], m[5 + s], m[10 + s], m[15 + s]);
+}
+
+/* For two patterns: sum_i = ((m_i0*p0 + m_i1*p1) + m_i2*p2) + m_i3*p3, the
+   DO_INTEGRATION macro's evaluation order. */
+DK_TARGET DK_INLINE __m256 integrate2(const __m256 c[4], const __m256 p) {
+    __m256 s = _mm256_mul_ps(c[0], _mm256_permute_ps(p, 0x00));
+    s = _mm256_add_ps(s, _mm256_mul_ps(c[1], _mm256_permute_ps(p, 0x55)));
+    s = _mm256_add_ps(s, _mm256_mul_ps(c[2], _mm256_permute_ps(p, 0xAA)));
+    s = _mm256_add_ps(s, _mm256_mul_ps(c[3], _mm256_permute_ps(p, 0xFF)));
+    return s;
+}
+
+/* The same for one pattern (low halves of the column vectors). */
+DK_TARGET DK_INLINE __m128 integrate1(const __m256 c[4], const __m128 p) {
+    __m128 s = _mm_mul_ps(_mm256_castps256_ps128(c[0]), _mm_permute_ps(p, 0x00));
+    s = _mm_add_ps(s, _mm_mul_ps(_mm256_castps256_ps128(c[1]), _mm_permute_ps(p, 0x55)));
+    s = _mm_add_ps(s, _mm_mul_ps(_mm256_castps256_ps128(c[2]), _mm_permute_ps(p, 0xAA)));
+    s = _mm_add_ps(s, _mm_mul_ps(_mm256_castps256_ps128(c[3]), _mm_permute_ps(p, 0xFF)));
+    return s;
+}
+
+DK_TARGET DK_INLINE __m256 pair128(const __m128 lo, const __m128 hi) {
+    return _mm256_insertf128_ps(_mm256_castps128_ps256(lo), hi, 1);
+}
+
+/* (x[k] x4, x[k+1] x4) */
+DK_TARGET DK_INLINE __m256 broadcastPair(const float* x) {
+    return pair128(_mm_broadcast_ss(x), _mm_broadcast_ss(x + 1));
+}
+
+/* A tip state outside 0..4 (only a negative one can get here: setTipStates
+   clamps the top) indexes the matrix exactly as the scalar code does. */
+DK_INLINE bool stateInTable(int s) { return (unsigned) s <= 4u; }
+
+DK_INLINE float matrixEntry(const float* m, int row, int state) {
+    return m[5 * row + state];
+}
+
+/* ------------------------------------------------------------------------ */
+/* Partials updates                                                          */
+/* ------------------------------------------------------------------------ */
+
+/* destP = sum1 * sum2                (calcPartialsPartials)
+   destP = sum1 * sum2 / scale[k]     (calcPartialsPartialsFixedScaling) */
+template <bool FIXED_SCALING>
+DK_TARGET void partialsPartials(float* destP,
+                                const float* partials1, const float* matrices1,
+                                const float* partials2, const float* matrices2,
+                                const float* scaleFactors,
+                                int categoryCount, int paddedPatternCount,
+                                int startPattern, int endPattern) {
+    for (int l = 0; l < categoryCount; l++) {
+        const int u0 = l * 4 * paddedPatternCount;
+        const int w = l * 4 * 5;
+        __m256 c1[4], c2[4];
+        loadColumns(matrices1 + w, c1);
+        loadColumns(matrices2 + w, c2);
+        int k = startPattern;
+        for (; k + 1 < endPattern; k += 2) {
+            const int u = u0 + 4 * k;
+            const __m256 s1 = integrate2(c1, _mm256_loadu_ps(partials1 + u));
+            const __m256 s2 = integrate2(c2, _mm256_loadu_ps(partials2 + u));
+            __m256 r = _mm256_mul_ps(s1, s2);
+            if (FIXED_SCALING)
+                r = _mm256_div_ps(r, broadcastPair(scaleFactors + k));
+            _mm256_storeu_ps(destP + u, r);
+        }
+        if (k < endPattern) {
+            const int u = u0 + 4 * k;
+            const __m128 s1 = integrate1(c1, _mm_loadu_ps(partials1 + u));
+            const __m128 s2 = integrate1(c2, _mm_loadu_ps(partials2 + u));
+            __m128 r = _mm_mul_ps(s1, s2);
+            if (FIXED_SCALING)
+                r = _mm_div_ps(r, _mm_broadcast_ss(scaleFactors + k));
+            _mm_storeu_ps(destP + u, r);
+        }
+    }
+}
+
+/* destP[i] = matrices1[5i + state1] * sum2_i            (calcStatesPartials)
+   destP[i] = matrices1[5i + state1] * sum2_i / scale[k] (...FixedScaling) */
+template <bool FIXED_SCALING>
+DK_TARGET void statesPartials(float* destP,
+                              const int* states1, const float* matrices1,
+                              const float* partials2, const float* matrices2,
+                              const float* scaleFactors,
+                              int categoryCount, int paddedPatternCount,
+                              int startPattern, int endPattern) {
+    for (int l = 0; l < categoryCount; l++) {
+        const int u0 = l * 4 * paddedPatternCount;
+        const int w = l * 4 * 5;
+        const float* m1 = matrices1 + w;
+        __m128 t1[5];
+        __m256 c2[4];
+        loadStateColumns(m1, t1);
+        loadColumns(matrices2 + w, c2);
+        int k = startPattern;
+        for (; k + 1 < endPattern; k += 2) {
+            const int u = u0 + 4 * k;
+            const int sa = states1[k], sb = states1[k + 1];
+            const __m256 s2 = integrate2(c2, _mm256_loadu_ps(partials2 + u));
+            __m256 a;
+            if (stateInTable(sa) && stateInTable(sb)) {
+                a = pair128(t1[sa], t1[sb]);
+            } else {
+                a = _mm256_setr_ps(matrixEntry(m1, 0, sa), matrixEntry(m1, 1, sa),
+                                   matrixEntry(m1, 2, sa), matrixEntry(m1, 3, sa),
+                                   matrixEntry(m1, 0, sb), matrixEntry(m1, 1, sb),
+                                   matrixEntry(m1, 2, sb), matrixEntry(m1, 3, sb));
+            }
+            __m256 r = _mm256_mul_ps(a, s2);
+            if (FIXED_SCALING)
+                r = _mm256_div_ps(r, broadcastPair(scaleFactors + k));
+            _mm256_storeu_ps(destP + u, r);
+        }
+        if (k < endPattern) {
+            const int u = u0 + 4 * k;
+            const int sa = states1[k];
+            const __m128 s2 = integrate1(c2, _mm_loadu_ps(partials2 + u));
+            const __m128 a = stateInTable(sa) ? t1[sa] :
+                _mm_setr_ps(matrixEntry(m1, 0, sa), matrixEntry(m1, 1, sa),
+                            matrixEntry(m1, 2, sa), matrixEntry(m1, 3, sa));
+            __m128 r = _mm_mul_ps(a, s2);
+            if (FIXED_SCALING)
+                r = _mm_div_ps(r, _mm_broadcast_ss(scaleFactors + k));
+            _mm_storeu_ps(destP + u, r);
+        }
+    }
+}
+
+/* destP[i] = matrices1[5i + state1] * matrices2[5i + state2]  (/ scale[k]) */
+template <bool FIXED_SCALING>
+DK_TARGET void statesStates(float* destP,
+                            const int* states1, const float* matrices1,
+                            const int* states2, const float* matrices2,
+                            const float* scaleFactors,
+                            int categoryCount, int paddedPatternCount,
+                            int startPattern, int endPattern) {
+    for (int l = 0; l < categoryCount; l++) {
+        const int u0 = l * 4 * paddedPatternCount;
+        const int w = l * 4 * 5;
+        const float* m1 = matrices1 + w;
+        const float* m2 = matrices2 + w;
+        __m128 t1[5], t2[5];
+        loadStateColumns(m1, t1);
+        loadStateColumns(m2, t2);
+        for (int k = startPattern; k < endPattern; k++) {
+            const int u = u0 + 4 * k;
+            const int sa = states1[k], sb = states2[k];
+            const __m128 a = stateInTable(sa) ? t1[sa] :
+                _mm_setr_ps(matrixEntry(m1, 0, sa), matrixEntry(m1, 1, sa),
+                            matrixEntry(m1, 2, sa), matrixEntry(m1, 3, sa));
+            const __m128 b = stateInTable(sb) ? t2[sb] :
+                _mm_setr_ps(matrixEntry(m2, 0, sb), matrixEntry(m2, 1, sb),
+                            matrixEntry(m2, 2, sb), matrixEntry(m2, 3, sb));
+            __m128 r = _mm_mul_ps(a, b);
+            if (FIXED_SCALING)
+                r = _mm_div_ps(r, _mm_broadcast_ss(scaleFactors + k));
+            _mm_storeu_ps(destP + u, r);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Edge likelihood                                                           */
+/* ------------------------------------------------------------------------ */
+
+/* integrationTmp (zeroed by the caller, as the scalar code does) +=
+     (P_l[i][stateChild] * parent_l[k][i]) * weight_l     (child is a tip)
+     (sum_li            * parent_l[k][i]) * weight_l      (child has partials)
+   category by category, exactly the scalar loop. */
+template <bool CHILD_STATES>
+DK_TARGET void edgeAccumulate(float* integrationTmp,
+                              const float* partialsParent,
+                              const int* statesChild, const float* partialsChild,
+                              const float* transMatrix, const float* weights,
+                              int categoryCount, int paddedPatternCount,
+                              int patternCount) {
+    for (int l = 0; l < categoryCount; l++) {
+        const float* m = transMatrix + l * 4 * 5;
+        const int v0 = l * 4 * paddedPatternCount;
+        const __m256 wt = _mm256_broadcast_ss(weights + l);
+        __m128 t[5];
+        __m256 c[4];
+        if (CHILD_STATES)
+            loadStateColumns(m, t);
+        else
+            loadColumns(m, c);
+        int k = 0;
+        for (; k + 1 < patternCount; k += 2) {
+            const int v = v0 + 4 * k;
+            __m256 a;
+            if (CHILD_STATES) {
+                const int sa = statesChild[k], sb = statesChild[k + 1];
+                if (stateInTable(sa) && stateInTable(sb))
+                    a = pair128(t[sa], t[sb]);
+                else
+                    a = _mm256_setr_ps(matrixEntry(m, 0, sa), matrixEntry(m, 1, sa),
+                                       matrixEntry(m, 2, sa), matrixEntry(m, 3, sa),
+                                       matrixEntry(m, 0, sb), matrixEntry(m, 1, sb),
+                                       matrixEntry(m, 2, sb), matrixEntry(m, 3, sb));
+            } else {
+                a = integrate2(c, _mm256_loadu_ps(partialsChild + v));
+            }
+            const __m256 x = _mm256_mul_ps(_mm256_mul_ps(a, _mm256_loadu_ps(partialsParent + v)), wt);
+            float* tmp = integrationTmp + 4 * k;
+            _mm256_storeu_ps(tmp, _mm256_add_ps(_mm256_loadu_ps(tmp), x));
+        }
+        if (k < patternCount) {
+            const int v = v0 + 4 * k;
+            __m128 a;
+            if (CHILD_STATES) {
+                const int sa = statesChild[k];
+                a = stateInTable(sa) ? t[sa] :
+                    _mm_setr_ps(matrixEntry(m, 0, sa), matrixEntry(m, 1, sa),
+                                matrixEntry(m, 2, sa), matrixEntry(m, 3, sa));
+            } else {
+                a = integrate1(c, _mm_loadu_ps(partialsChild + v));
+            }
+            const __m128 x = _mm_mul_ps(_mm_mul_ps(a, _mm_loadu_ps(partialsParent + v)),
+                                        _mm256_castps256_ps128(wt));
+            float* tmp = integrationTmp + 4 * k;
+            _mm_storeu_ps(tmp, _mm_add_ps(_mm_loadu_ps(tmp), x));
+        }
+    }
+}
+
+/* sumOverI[k] = ((f0*t0 + f1*t1) + f2*t2) + f3*t3 over integrationTmp, the
+   integrateOutStatesAndScale expression. */
+DK_TARGET inline void integrateStates(float* sumOverI, const float* integrationTmp,
+                                      const float* freqs, int patternCount) {
+    const __m128 f128 = _mm_setr_ps(freqs[0], freqs[1], freqs[2], freqs[3]);
+    const __m256 f = pair128(f128, f128);
+    int k = 0;
+    for (; k + 1 < patternCount; k += 2) {
+        const __m256 q = _mm256_mul_ps(f, _mm256_loadu_ps(integrationTmp + 4 * k));
+        __m256 s = _mm256_add_ps(_mm256_permute_ps(q, 0x00), _mm256_permute_ps(q, 0x55));
+        s = _mm256_add_ps(s, _mm256_permute_ps(q, 0xAA));
+        s = _mm256_add_ps(s, _mm256_permute_ps(q, 0xFF));
+        sumOverI[k]     = _mm256_cvtss_f32(s);
+        sumOverI[k + 1] = _mm_cvtss_f32(_mm256_extractf128_ps(s, 1));
+    }
+    if (k < patternCount) {
+        const __m128 q = _mm_mul_ps(f128, _mm_loadu_ps(integrationTmp + 4 * k));
+        __m128 s = _mm_add_ps(_mm_permute_ps(q, 0x00), _mm_permute_ps(q, 0x55));
+        s = _mm_add_ps(s, _mm_permute_ps(q, 0xAA));
+        s = _mm_add_ps(s, _mm_permute_ps(q, 0xFF));
+        sumOverI[k] = _mm_cvtss_f32(s);
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Rescaling                                                                 */
+/* ------------------------------------------------------------------------ */
+
+/* The scalar loop keeps max = 0 and replaces it by each entry with
+   entry > max. That ends at the largest entry (or +0 when none is positive)
+   whatever the visiting order: a NaN never compares greater, a negative or -0
+   entry never beats +0, and equal positive floats are the same bits.
+   maxps(x, m) returns m unless x > m (it returns the second operand for NaN
+   and for equal zeros), so it is that step exactly. */
+DK_TARGET inline void patternMaxima(float* maxima, const float* destP,
+                                    int categoryCount, int paddedPatternCount,
+                                    int patternCount) {
+    int k = 0;
+    for (; k + 1 < patternCount; k += 2) {
+        __m256 m = _mm256_setzero_ps();
+        for (int l = 0; l < categoryCount; l++)
+            m = _mm256_max_ps(_mm256_loadu_ps(destP + l * 4 * paddedPatternCount + 4 * k), m);
+        m = _mm256_max_ps(_mm256_permute_ps(m, 0x4E), m);   /* (2,3,0,1) */
+        m = _mm256_max_ps(_mm256_permute_ps(m, 0xB1), m);   /* (1,0,3,2) */
+        maxima[k]     = _mm256_cvtss_f32(m);
+        maxima[k + 1] = _mm_cvtss_f32(_mm256_extractf128_ps(m, 1));
+    }
+    if (k < patternCount) {
+        __m128 m = _mm_setzero_ps();
+        for (int l = 0; l < categoryCount; l++)
+            m = _mm_max_ps(_mm_loadu_ps(destP + l * 4 * paddedPatternCount + 4 * k), m);
+        m = _mm_max_ps(_mm_permute_ps(m, 0x4E), m);
+        m = _mm_max_ps(_mm_permute_ps(m, 0xB1), m);
+        maxima[k] = _mm_cvtss_f32(m);
+    }
+}
+
+/* destP[l][k][i] *= oneOverMax[k] */
+DK_TARGET inline void scalePatterns(float* destP, const float* oneOverMax,
+                                    int categoryCount, int paddedPatternCount,
+                                    int patternCount) {
+    for (int l = 0; l < categoryCount; l++) {
+        float* d = destP + l * 4 * paddedPatternCount;
+        int k = 0;
+        for (; k + 1 < patternCount; k += 2)
+            _mm256_storeu_ps(d + 4 * k, _mm256_mul_ps(_mm256_loadu_ps(d + 4 * k),
+                                                      broadcastPair(oneOverMax + k)));
+        if (k < patternCount)
+            _mm_storeu_ps(d + 4 * k, _mm_mul_ps(_mm_loadu_ps(d + 4 * k),
+                                                _mm_broadcast_ss(oneOverMax + k)));
+    }
+}
+
+}   // namespace dk
+}   // namespace cpu
