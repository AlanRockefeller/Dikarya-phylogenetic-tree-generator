--- /dev/null
+++ b/libhmsbeagle/CPU/DikaryaThreads.h
@@ -0,0 +1,175 @@
+/*
+ *  DikaryaThreads.h
+ *
+ *  A small fork-join pool for splitting one likelihood call across threads
+ *  by site pattern. Every pattern is computed by the same kernel code
+ *  whichever thread runs it, and anything summed over patterns is summed
+ *  afterwards by the caller in the original order, so results do not depend
+ *  on the number of threads or on which thread ran which range.
+ *
+ *  The caller always takes part and always runs chunk 0. Chunks are claimed with a compare-and-swap
+ *  on a ticket that carries the job number, so a worker that wakes late
+ *  never claims a chunk of a later job, and a worker that is descheduled
+ *  before claiming anything costs nothing: the caller runs the remaining
+ *  chunks itself. Workers spin briefly between jobs (MrBayes calls the
+ *  library every few tens of microseconds) and then sleep on a condition
+ *  variable; BEAGLE_DIKARYA_SPIN_US sets the spin time.
+ */
+
+#ifndef __BeagleDikaryaThreads__
+#define __BeagleDikaryaThreads__
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include <x86intrin.h>
+
+namespace beagle {
+namespace cpu {
+namespace dk {
+
+class Pool {
+public:
+    typedef void (*ChunkFn)(void* ctx, int chunk);
+
+    explicit Pool(int nThreads) : kThreads(nThreads < 1 ? 1 : nThreads) {
+        const char* s = getenv("BEAGLE_DIKARYA_SPIN_US");
+        long us = s ? atol(s) : 300;
+        spinCycles = (uint64_t) (us < 0 ? 0 : us) * 2600u;   /* TSC ticks, ~2.6 GHz */
+        for (int i = 1; i < kThreads; i++)
+            workers.push_back(std::thread(&Pool::workerLoop, this));
+    }
+
+    ~Pool() {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            stop.store(true, std::memory_order_seq_cst);
+        }
+        cv.notify_all();
+        for (size_t i = 0; i < workers.size(); i++)
+            workers[i].join();
+    }
+
+    int threads() const { return kThreads; }
+
+    /* fn(ctx, c) for every c in [0, nChunks); returns when all have finished */
+    void run(int nChunks, ChunkFn f, void* c) {
+        if (kThreads == 1 || nChunks <= 1) {
+            for (int i = 0; i < nChunks; i++)
+                f(c, i);
+            return;
+        }
+        jobChunks.store(nChunks, std::memory_order_relaxed);
+        jobFn = f;
+        jobCtx = c;
+        done.store(0, std::memory_order_relaxed);
+        const uint32_t s = ++seq;
+        /* chunk 0 belongs to the caller, so with one chunk per thread each
+           thread keeps working on the same patterns call after call (their
+           partials stay in its own cache); workers claim from chunk 1 on,
+           and the caller takes over any chunk no worker has claimed yet */
+        ticket.store(((uint64_t) s << 32) | 1u, std::memory_order_seq_cst);
+        if (sleeping.load(std::memory_order_seq_cst) > 0) {
+            std::lock_guard<std::mutex> lk(m);
+            cv.notify_all();
+        }
+        f(c, 0);
+        done.fetch_add(1, std::memory_order_release);
+        claimAndRun(s);
+        while (done.load(std::memory_order_acquire) < nChunks)
+            _mm_pause();
+    }
+
+private:
+    /* claim chunks of job s until none are left; true if any were run */
+    bool claimAndRun(uint32_t s) {
+        bool ran = false;
+        uint64_t t = ticket.load(std::memory_order_acquire);
+        for (;;) {
+            if ((uint32_t) (t >> 32) != s)
+                return ran;
+            const int c = (int) (uint32_t) t;
+            if (c >= jobChunks.load(std::memory_order_relaxed))
+                return ran;
+            if (ticket.compare_exchange_weak(t, t + 1, std::memory_order_acq_rel, std::memory_order_acquire)) {
+                jobFn(jobCtx, c);
+                done.fetch_add(1, std::memory_order_release);
+                ran = true;
+                t = ticket.load(std::memory_order_acquire);
+            }
+        }
+    }
+
+    void workerLoop() {
+        uint32_t seen = 0;
+        for (;;) {
+            uint32_t s = (uint32_t) (ticket.load(std::memory_order_acquire) >> 32);
+            if (s == seen) {
+                const uint64_t t0 = __rdtsc();
+                while (s == seen && !stop.load(std::memory_order_relaxed) && __rdtsc() - t0 < spinCycles) {
+                    _mm_pause();
+                    s = (uint32_t) (ticket.load(std::memory_order_acquire) >> 32);
+                }
+                if (s == seen) {
+                    std::unique_lock<std::mutex> lk(m);
+                    sleeping.fetch_add(1, std::memory_order_seq_cst);
+                    while ((s = (uint32_t) (ticket.load(std::memory_order_seq_cst) >> 32)) == seen
+                           && !stop.load(std::memory_order_seq_cst))
+                        cv.wait(lk);
+                    sleeping.fetch_sub(1, std::memory_order_seq_cst);
+                }
+            }
+            if (stop.load(std::memory_order_acquire))
+                return;
+            seen = s;
+            claimAndRun(s);
+        }
+    }
+
+    const int kThreads;
+    uint64_t spinCycles;
+    std::vector<std::thread> workers;
+    std::atomic<uint64_t> ticket{0};   /* job number << 32 | next chunk */
+    std::atomic<int> done{0};
+    std::atomic<int> sleeping{0};
+    std::atomic<bool> stop{false};
+    uint32_t seq = 0;                  /* written by the caller only */
+    std::atomic<int> jobChunks{0};
+    ChunkFn jobFn = nullptr;
+    void* jobCtx = nullptr;
+    std::mutex m;
+    std::condition_variable cv;
+};
+
+/* Per-thread hand-off between the operation loop, which knows buffer
+   indices, and the kernels, which only see pointers: which rate categories
+   of the children may hold subnormal partials, and which of the result may. Only speed
+   depends on these; the defaults are the cautious answers. */
+struct OpState {
+    unsigned inMaySub = 0xFFu;    /* bit per category (see catBit) */
+    unsigned outMaySub = 0xFFu;
+};
+inline OpState& opState() {
+    static thread_local OpState s;
+    return s;
+}
+
+/* Split [0, n) into `parts` ranges with even boundaries (two patterns per
+   vector in the kernels), returning range i as [*lo, *hi). */
+inline void evenRange(int n, int parts, int i, int* lo, int* hi) {
+    const int pairs = (n + 1) / 2;
+    *lo = 2 * (int) ((int64_t) pairs * i / parts);
+    *hi = 2 * (int) ((int64_t) pairs * (i + 1) / parts);
+    if (*lo > n) *lo = n;
+    if (*hi > n) *hi = n;
+}
+
+}   // namespace dk
+}   // namespace cpu
+}   // namespace beagle
+
+#endif  // __BeagleDikaryaThreads__
