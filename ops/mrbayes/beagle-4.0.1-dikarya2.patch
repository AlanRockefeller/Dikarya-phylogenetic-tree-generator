+/* integrate2/integrate1 with exact (double) products. cd[j] is column j in
+   double (one pattern's four states); each product is rounded to float once,
+   then the sum is formed in single precision in the original order. */
+DK_TARGET DK_INLINE void loadColumnsDouble(const __m256 c[4], __m256d cd[4]) {
+    for (int j = 0; j < 4; j++)
+        cd[j] = _mm256_cvtps_pd(_mm256_castps256_ps128(c[j]));
+}
+DK_TARGET DK_INLINE __m128 integrate1xd(const __m256d cd[4], const __m128 p) {
+    const __m256d q = _mm256_cvtps_pd(p);
+    __m128 s = _mm256_cvtpd_ps(_mm256_mul_pd(cd[0], _mm256_permute4x64_pd(q, 0x00)));
+    s = _mm_add_ps(s, _mm256_cvtpd_ps(_mm256_mul_pd(cd[1], _mm256_permute4x64_pd(q, 0x55))));
+    s = _mm_add_ps(s, _mm256_cvtpd_ps(_mm256_mul_pd(cd[2], _mm256_permute4x64_pd(q, 0xAA))));
+    s = _mm_add_ps(s, _mm256_cvtpd_ps(_mm256_mul_pd(cd[3], _mm256_permute4x64_pd(q, 0xFF))));
+    return s;
+}
+DK_TARGET DK_INLINE __m256 integrate2xd(const __m256d cd[4], const __m256 p) {
+    return pair128(integrate1xd(cd, _mm256_castps256_ps128(p)),
+                   integrate1xd(cd, _mm256_extractf128_ps(p, 1)));
