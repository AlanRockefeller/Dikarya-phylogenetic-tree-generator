+/* ------------------------------------------------------------------------ */
+/* Subnormals                                                                */
+/* ------------------------------------------------------------------------ */
+/*
+ * On x86, a float multiply whose input or result is subnormal, and a divide
+ * with a subnormal numerator, take a microcode assist (~120 and ~150 cycles
+ * on Broadwell); adds, max and compares never do. Single-precision partials
+ * reach the subnormal range routinely on larger trees between MrBayes's
+ * scaler nodes, and the assists were then about half of the kernel time.
+ *
+ * Two exact ways around them are used:
+ *
+ *  - the fast attempt: a category is computed with flush-to-zero on (DAZ
+ *    off) and the underflow flag cleared. Flush-to-zero changes a result
+ *    only when that result is tiny, and every tiny result sets the underflow
+ *    flag, so if the flag is still clear the output is exactly the IEEE
+ *    result. Otherwise the category is computed again by
+ *  - the guarded kernels: any multiply or divide that could involve a
+ *    subnormal is done in double, (float)((double)a * b). A product of two
+ *    floats is exact in double and is rounded once, as the float multiply
+ *    rounds it (gradual underflow included); for division double rounding is
+ *    innocuous because 53 >= 2*24 + 2 (Figueroa 1995). Conversions do not
+ *    assist. Adds stay in single precision, in the original order.
+ *
+ * The checks that pick a path only decide speed, never the result: both paths
+ * compute the same IEEE single-precision values.
+ */
+
+/* MXCSR: flags in bits 0-5 (UE = 0x10), DAZ 0x40, rounding 0x6000, FTZ 0x8000 */
+DK_INLINE bool ftzUsable(unsigned csr) { return (csr & 0xE040u) == 0; }   /* nearest, no FTZ/DAZ */
+DK_INLINE void ftzBegin(unsigned csr) { _mm_setcsr((csr & ~0x3Fu) | 0x8000u); }
+DK_INLINE bool ftzUnderflowed() { return (_mm_getcsr() & 0x10u) != 0; }
+
+DK_INLINE float xmul(float a, float b) { return (float) ((double) a * (double) b); }
+DK_INLINE float xdiv(float a, float b) { return (float) ((double) a / (double) b); }
+
+DK_TARGET DK_INLINE __m128 xmul4(const __m128 a, const __m128 b) {
+    return _mm256_cvtpd_ps(_mm256_mul_pd(_mm256_cvtps_pd(a), _mm256_cvtps_pd(b)));
+}
+DK_TARGET DK_INLINE __m128 xdiv4(const __m128 a, const __m128 b) {
+    return _mm256_cvtpd_ps(_mm256_div_pd(_mm256_cvtps_pd(a), _mm256_cvtps_pd(b)));
+}
+DK_TARGET DK_INLINE __m256 xmul8(const __m256 a, const __m256 b) {
+    return pair128(xmul4(_mm256_castps256_ps128(a), _mm256_castps256_ps128(b)),
+                   xmul4(_mm256_extractf128_ps(a, 1), _mm256_extractf128_ps(b, 1)));
+}
+DK_TARGET DK_INLINE __m256 xdiv8(const __m256 a, const __m256 b) {
+    return pair128(xdiv4(_mm256_castps256_ps128(a), _mm256_castps256_ps128(b)),
+                   xdiv4(_mm256_extractf128_ps(a, 1), _mm256_extractf128_ps(b, 1)));
