 static double Ltracking( double *lasthorizontalw, double *lastverticalw, 
 						char **seq1, char **seq2, 
                         char **mseq1, char **mseq2, 
@@ -132,19 +181,24 @@ static double Ltracking( double *lasthorizontalw, double *lastverticalw,
 	limk = lgth1+lgth2;
